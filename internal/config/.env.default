# tick configuration

# Price, FX and news providers. Each can be a comma separated list, tried in order.
EQUITY_PRICE_PROVIDERS=finnhub
CRYPTO_PRICE_PROVIDERS=coingecko
COMMODITY_PRICE_PROVIDERS=yahoo
FX_PROVIDERS=frankfurter
NEWS_PROVIDERS=newsapiorg
# Funds are priced from prices you record with `tick prices`.
FUND_PRICES_PROVIDERS=consumed

# Required if using finnhub / newsapiorg
FINNHUB_API_KEY=""
NEWSAPIORG_API_KEY=""

# Cache settings
CACHE_ENABLED=true
CACHE_PRICE_TTL=15m
CACHE_FX_TTL=12h
CONSUMED_PRICE_MAX_AGE=720h

# LLM (optional)
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Required by `tick serve`: a random value of at least 16 characters, e.g. openssl rand -hex 32
# TICK_API_TOKEN=
